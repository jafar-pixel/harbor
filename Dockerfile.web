# syntax=docker/dockerfile:1
# The JL Media Vision website on its own server (server/web-server.ts), in place of Vercel.
# Build: the app is built from this checkout; .env.local supplies VITE_JL_SUPABASE_URL and
# VITE_JL_SUPABASE_ANON_KEY (public values, built into the pages as on every release).
FROM node:22-bookworm-slim AS build
RUN npm install -g corepack@latest && corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack prepare --activate && pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 JL_WEB_DIST=/app/dist
COPY package.json ./
COPY api ./api
COPY server ./server
COPY src/lib/jl/sports/data/colleges.json ./src/lib/jl/sports/data/colleges.json
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "--experimental-strip-types", "server/web-server.ts"]
